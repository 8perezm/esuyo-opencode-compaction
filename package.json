{
  "name": "@esuyo/esuyo-opencode-compaction",
  "version": "0.1.2",
  "description": "OpenCode plugin that compacts a session at a fixed 256k context reference (15% reserve) with a per-session on/off command.",
  "license": "Apache-2.0",
  "author": "Miguel Perez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8perezm/esuyo-opencode-compaction.git"
  },
  "homepage": "https://github.com/8perezm/esuyo-opencode-compaction#readme",
  "bugs": {
    "url": "https://github.com/8perezm/esuyo-opencode-compaction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "compaction",
    "context",
    "tokens",
    "tui"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "oc-plugin": [
    "server",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "compaction-guard.example.json",
    "compaction-guard.schema.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run pack:check"
  },
  "engines": {
    "opencode": ">=2.2.6 <3"
  },
  "peerDependencies": {
    "@opencode/client": "^2.2.6",
    "@opencode/plugin": "^2.2.6",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/client": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "^2.2.6",
    "@opencode/plugin": "^2.2.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
